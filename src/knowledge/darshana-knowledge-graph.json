      }
    },
    {
      "id": "concept:prameya",
      "label": "??????",
      "type": "Concept",
      "properties": {
        "description": "That which is to be known through pramāṇas. The objects of knowledge.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:dvadasha-prameya",
      "label": "?????? ??????",
