        "system": "Nyāya"
      }
    },
    {
      "id": "concept:tarka",
      "label": "????",
      "type": "Concept",
      "properties": {
        "description": "A process of reasoning that assists in knowing the true nature of a thing by revealing the absurdities of contrary suppositions.",
