    {
      "id": "concept:pramana",
      "label": "प्रमाण",
      "type": "Concept",
      "properties": {
        "description": "The fundamental instruments or sources through which accurate, valid knowledge (pramā) of the world is acquired. Nyaya accepts four: Perception, Inference, Analogy, and Verbal Testimony.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:pratyaksha",
      "label": "प्रत्यक्ष",
      "type": "Concept",
      "properties": {
        "description": "Direct, unmediated knowledge arising from the contact (sannikarsha) of a sense organ with its object. It must be non-erroneous, determinate, and not dependent on verbal cognition.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:anumana",
      "label": "अनुमान",
      "type": "Concept",
      "properties": {
        "description": "Cognition that follows a prior perception. It is the logical deduction of an unperceived object (like fire) based on the perception of a logical sign or mark (like smoke), relying on the memory of their invariable concomitance (vyapti).",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:upamana",
      "label": "उपमान",
      "type": "Concept",
      "properties": {
        "description": "Knowledge of the relationship between a name and the object it denotes, based on a recognized similarity to a familiar object (e.g., identifying a wild gavaya because one was told it looks like a cow).",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:shabda",
      "label": "शब्द",
      "type": "Concept",
      "properties": {
        "description": "The instructive assertion of a reliable, trustworthy authority (Apta). It provides valid knowledge regarding both perceptible things (worldly facts) and imperceptible things (spiritual realms).",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:apta",
      "label": "आप्त",
      "type": "Concept",
      "properties": {
        "description": "A person who has direct, accurate knowledge of a subject, is devoid of prejudices or motives to deceive, and communicates clearly out of compassion or a sense of duty.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:samaya",
      "label": "समय",
      "type": "Concept",
      "properties": {
        "description": "The established, historical agreement within a community that a specific word denotes a specific object or meaning.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:veda",
      "label": "वेद",
      "type": "Concept",
      "properties": {
        "description": "The ultimate corpus of spiritual and ritual knowledge in Indian philosophy, considered valid because they are the testimony of supreme Aptas (ancient seers or God).",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:vidhi",
      "label": "विधि",
      "type": "Concept",
      "properties": {
        "description": "A direct prescriptive statement or command in a text urging the listener to perform a specific action to achieve a specific result.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:arthavada",
      "label": "अर्थवाद",
      "type": "Concept",
      "properties": {
        "description": "Sentences that provide praise, blame, historical context, or mythological backing to support and motivate the performance of a primary Injunction (Vidhi).",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:anuvada",
      "label": "अनुवाद",
      "type": "Concept",
      "properties": {
        "description": "The repetition of a previously stated command or concept for the sake of emphasis, clarification, or instructional continuity.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:purvapaksha",
      "label": "पूर्वपक्ष",
      "type": "Concept",
      "properties": {
        "description": "The initial argument, counter-claim, or skeptical objection presented against an established doctrine.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:siddhanta",
      "label": "सिद्धान्त",
      "type": "Concept",
      "properties": {
        "description": "The final, proven doctrinal truth established after thoroughly refuting the opponent",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:atman",
      "label": "आत्मन्",
      "type": "Concept",
      "properties": {
        "description": "The eternal, immaterial substance that is the substratum of consciousness, desire, aversion, effort, pleasure, and pain.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:manas",
      "label": "मनस्",
      "type": "Concept",
      "properties": {
        "description": "The atomic, internal sense organ that mediates between the eternal soul and the external senses. It can only process one cognition at a time.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:sannikarsha",
      "label": "सन्निकर्ष",
      "type": "Concept",
      "properties": {
        "description": "The physical and cognitive connection between a sense organ (like the eye) and its corresponding object (like color) that triggers direct perception.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:avayavin",
      "label": "अवयविन्",
      "type": "Concept",
      "properties": {
        "description": "A distinct, unified substance that comes into existence when its parts (avayava) combine. A pot is not just a pile of clay atoms; it is a new entity: ",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:kala",
      "label": "काल",
      "type": "Concept",
      "properties": {
        "description": "The eternal, all-pervading substance that causes our cognitions of past, present, and future, and acts as the universal container for all actions.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:samsaya",
      "label": "????",
      "type": "Concept",
      "properties": {
        "description": "A conflicting judgment regarding the exact character of an object, arising from the perception of properties common to many objects.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:shodasha-padartha",
      "label": "??? ?? ????????",
      "type": "Concept",
      "properties": {
        "description": "The sixteen topics of inquiry outlined by Gautama: means of knowledge, objects of knowledge, doubt, purpose, familiar instance, established tenet, members of a syllogism, confutation, ascertainment, discussion, wrangling, cavil, fallacies, quibbling, futile rejoinders, and clinchers.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:pariksha",
      "label": "???????",
      "type": "Concept",
      "properties": {
        "description": "The critical investigation and testing of a subject that has been defined.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:duhkha-chain-nyaya",
      "label": "????-???????",
      "type": "Concept",
      "properties": {
        "description": "The causal chain leading from false knowledge to suffering, and its reversal leading to liberation.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:jnana",
      "label": "????",
      "type": "Concept",
      "properties": {
        "description": "The apprehension or apprehension-producing activity that illuminates objects.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:vipratipatti",
      "label": "???????????",
