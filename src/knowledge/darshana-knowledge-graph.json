      }
    },
    {
      "id": "concept:drishtanta",
      "label": "????????",
      "type": "Concept",
      "properties": {
        "description": "An undisputed example that both ordinary people and experts agree upon.",
        "system": "Nyāya"
      }
    },
    {
      "id": "concept:anavastha",
      "label": "????????",
      "type": "Concept",
