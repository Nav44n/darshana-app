      }
    },
    {
      "id": "concept:sharira-indriya-bhuta",
      "label": "?????-???????-???",
      "type": "Concept",
      "properties": {
        "description": "The physical architecture of interaction: the body is the site of experience, the senses are the instruments, and the material elements are their objects.",
